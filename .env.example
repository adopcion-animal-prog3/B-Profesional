# Node / general
PORT=3000
# Generate a secret locally with: openssl rand -base64 32
JWT_SECRET=

# Database connection used by Express
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adopcion_db
DB_USER=postgres
DB_PASSWORD=postgres

# Postgres settings used by Docker Compose
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adopcion_db
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata

# Docker

# Correo para los códigos de verificación (sin SMTP_HOST se escriben en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Huellitas <no-reply@huellitas.local>
# Solo desarrollo: cargar usuarios y mascotas de ejemplo al iniciar.
SEED_DEMO_DATA=false
